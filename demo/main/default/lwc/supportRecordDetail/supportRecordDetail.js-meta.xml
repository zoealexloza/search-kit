<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Support Record Detail (demo)</masterLabel>
    <description
  >Demo only: shows a Known Issue or Case on the support portal's record pages.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="recordId"
        type="String"
        label="Record ID"
        default="{!recordId}"
      />
            <property
        name="objectApiName"
        type="String"
        label="Object API name"
        description="Known_Issue__c or Case."
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
