<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_Category_Operator__c</fullName>
    <description
  >Knowledge only: whether results must be in the data category itself (at) or in it or any category below it (at_or_below).</description>
    <fieldManageability>SubscriberControlled</fieldManageability>
    <inlineHelpText
  >Knowledge only. At: articles in exactly this category. At or below: this category and every category under it.</inlineHelpText>
    <label>Data Category Operator</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>at_or_below</fullName>
                <default>true</default>
                <label>At or Below</label>
            </value>
            <value>
                <fullName>at</fullName>
                <default>false</default>
                <label>At</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
